# =============================================================================
# Telegram Calendar Bot - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in the required values
# cp .env.example .env

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Telegram Bot API Token
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Host
# Default: postgres (when using docker-compose)
# For local development: localhost
POSTGRES_HOST=postgres

# PostgreSQL Database User
# Default: postgres
POSTGRES_USER=postgres

# PostgreSQL Database Password
# Default: postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL Database Name
# Default: telegram_calendar
POSTGRES_DB=telegram_calendar

# PostgreSQL Database Port
# Default: 5432
POSTGRES_PORT=5432

# =============================================================================
# CALENDAR SYNCHRONIZATION SETTINGS
# =============================================================================

# Sync Interval (in seconds)
# How often the bot checks for external calendar updates
# Default: 10 seconds
# Recommended values:
#   - Development: 10-30 seconds
#   - Production: 60-300 seconds (1-5 minutes)
#   - High frequency: 10-60 seconds
SYNC_INTERVAL=3600

# Sync Workers Count
# Number of parallel workers that process calendar synchronization
# Default: 2
# Increase this value if you have many calendars to sync
# Recommended: 2-4 workers
SYNC_WORKERS=2

# =============================================================================
# BOT OPERATION MODE
# =============================================================================

# Single User Mode
# Set to 'true' to enable single user mode (only one user can use the bot)
# Set to 'false' for multi-user mode (default)
# Default: false
SINGLE_USER=false

# Development Mode
# Set to 'true' to enable hot reload (auto-restart on file changes)
# Set to 'false' for production mode
# Default: true (in docker-compose.yml), false (in docker-compose.stage.yml)
DEV_MODE=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: DEBUG
# Production recommendation: INFO
LOG_LEVEL=DEBUG

# =============================================================================
# OPENTELEMETRY / GRAFANA CLOUD (Optional)
# =============================================================================

# OpenTelemetry OTLP Endpoint
# Endpoint URL for sending logs/metrics to Grafana Cloud
# Leave empty to disable OpenTelemetry logging
# Example: https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenTelemetry Resource Attributes
# Additional attributes to attach to telemetry data
# Format: key1=value1,key2=value2
# Example: service.name=telegram-calendar-bot,service.namespace=XXX,deployment.environment=production
OTEL_RESOURCE_ATTRIBUTES=

# OpenTelemetry OTLP Headers
# Headers for authentication with Grafana Cloud
# Format: Authorization=Basic <base64-encoded-credentials>
# Example: Authorization=Basic <your-credentials>
OTEL_EXPORTER_OTLP_HEADERS=

# OpenTelemetry OTLP Protocol
# Protocol to use for OTLP export
# Options: http/protobuf, grpc
# Default: http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================

# Timezone (IANA format)
# Timezone for the application
# Examples: Europe/Moscow, Asia/Almaty, America/New_York, UTC
# If not set, will use timezone from mounted /etc/localtime in Docker
# Leave empty to use system timezone
TZ=

# =============================================================================
# PGADMIN CONFIGURATION (Optional - for database management)
# =============================================================================

# PgAdmin Default Email
# Email for logging into PgAdmin web interface
# Default: admin@admin.com
PGADMIN_DEFAULT_EMAIL=admin@admin.com

# PgAdmin Default Password
# Password for logging into PgAdmin web interface
# Default: admin
# WARNING: Change this in production!
PGADMIN_DEFAULT_PASSWORD=admin

# PgAdmin Port
# Port for accessing PgAdmin web interface
# Default: 5050
PGADMIN_PORT=5050
